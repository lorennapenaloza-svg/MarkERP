@model List<ProveedorProducto>
@{ ViewData["Title"] = "¿Quién vende este producto?"; ViewData["Migas"] = "Proveedores · consulta"; ViewData["Modulo"] = "proveedores"; var prod = ViewBag.Producto as Producto; }
<div class="tarjeta mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-6"><label class="form-label">Producto</label><select name="productoId" class="form-select" asp-items="ViewBag.Productos" onchange="this.form.submit()"><option value="">Elige un producto…</option></select></div>
        <div class="col-auto"><button class="btn btn-mk"><i class="bi bi-search"></i> Consultar</button></div>
    </form>
</div>
@if (prod != null)
{
    <div class="row g-3">
    @if (!Model.Any()) { <div class="col-12"><div class="tarjeta text-suave">Ningún proveedor tiene asociado este producto. Agrégalo desde la ficha del proveedor.</div></div> }
    @{ var i = 0; }
    @foreach (var pp in Model)
    {
        var ahorro = prod.PrecioCompra - pp.PrecioReferencia;
        <div class="col-md-6 col-xl-4">
            <div class="cot-card @(i == 0 ? "recomendada" : "")">
                @if (i == 0) { <span class="pill ok mb-2"><i class="bi bi-trophy"></i> Mejor precio</span> }
                <div class="fw-semibold"><a asp-action="Detalle" asp-route-id="@pp.ProveedorId">@pp.Proveedor?.RazonSocial</a></div>
                <div class="small text-suave mb-2">@pp.Proveedor?.Ciudad · @pp.Proveedor?.Contacto · @pp.Proveedor?.Telefono</div>
                <div class="fs-4 fw-bold">@Calculos.Moneda(pp.PrecioReferencia)</div>
                <div class="small @(ahorro >= 0 ? "" : "text-suave")">@(ahorro >= 0 ? "Ahorras " + Calculos.Moneda(ahorro) : "Cuesta " + Calculos.Moneda(-ahorro) + " más") frente al costo actual</div>
                <div class="d-flex gap-1 flex-wrap mt-2"><span class="pill info">@pp.Proveedor?.TiempoEntregaDias @(pp.Proveedor?.TiempoEntregaDias == 1 ? "día" : "días")</span><span class="pill gris">@pp.Proveedor?.CondicionesPago</span><span class="pill alerta"><i class="bi bi-star"></i> @pp.Proveedor?.Calificacion.ToString("0.0")</span></div>
            </div>
        </div>
        i++;
    }
    </div>
    <div class="mt-3"><a asp-controller="Cotizaciones" asp-action="Nueva" asp-route-productoId="@prod.Id" class="btn btn-mk"><i class="bi bi-file-earmark-text"></i> Pedir cotización a estos proveedores</a></div>
}
