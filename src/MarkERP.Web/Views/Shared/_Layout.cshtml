@inject ConfiguracionService ConfigSrv
@{
    var config = await ConfigSrv.ObtenerAsync();
    var modulo = ViewData["Modulo"] as string ?? "inicio";
    var u = User;
    bool admin = u.IsInRole(Roles.Admin), ventas = u.EsRol(Roles.Admin, Roles.Vendedor),
         inv = u.EsRol(Roles.Admin, Roles.Inventario), th = u.EsRol(Roles.Admin, Roles.TalentoHumano);
    string Activo(string m) => m == modulo ? "activo" : "";
    var iniciales = string.Concat((u.Identity?.Name ?? "U").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[0]));
}
<!DOCTYPE html>
<html lang="es" data-theme="@config.TemaPorDefecto">
<head>
    <partial name="_Head" />
    <title>@ViewData["Title"] · MARKERP</title>
</head>
<body class="mod-@modulo">
<div class="burbujas"><span></span><span></span><span></span></div>
<div class="app">
    <aside class="sidebar">
        <div class="marca"><div class="logo"><i class="bi bi-boxes"></i></div> markerp</div>
        <nav class="nav-mk">
            <a asp-controller="Home" asp-action="Index" data-m="inicio" class="@Activo("inicio")"><span class="ico"><i class="bi bi-house"></i></span>Inicio</a>

            @if (ventas)
            {
                <div class="nav-grupo">Comercial</div>
                <a asp-controller="Ventas" asp-action="Index" data-m="ventas" class="@Activo("ventas")"><span class="ico"><i class="bi bi-bag-heart"></i></span>Ventas</a>
                <a asp-controller="Clientes" asp-action="Index" data-m="clientes" class="@Activo("clientes")"><span class="ico"><i class="bi bi-people"></i></span>Clientes</a>
            }

            <div class="nav-grupo">Operación</div>
            <a asp-controller="Productos" asp-action="Index" data-m="inventario" class="@Activo("inventario")"><span class="ico"><i class="bi bi-box-seam"></i></span>Inventario</a>
            @if (inv)
            {
                <a asp-controller="Proveedores" asp-action="Index" data-m="proveedores" class="@Activo("proveedores")"><span class="ico"><i class="bi bi-truck"></i></span>Proveedores</a>
                <a asp-controller="Cotizaciones" asp-action="Index" data-m="cotizaciones" class="@Activo("cotizaciones")"><span class="ico"><i class="bi bi-file-earmark-text"></i></span>Cotizaciones</a>
                <a asp-controller="OrdenesCompra" asp-action="Index" data-m="compras" class="@Activo("compras")"><span class="ico"><i class="bi bi-cart-check"></i></span>Compras</a>
            }

            @if (th)
            {
                <div class="nav-grupo">Personas</div>
                <a asp-controller="Empleados" asp-action="Index" data-m="talento" class="@Activo("talento")"><span class="ico"><i class="bi bi-person-vcard"></i></span>Talento humano</a>
            }

            @if (admin)
            {
                <div class="nav-grupo">Gestión</div>
                <a asp-controller="Reportes" asp-action="Index" data-m="reportes" class="@Activo("reportes")"><span class="ico"><i class="bi bi-bar-chart-line"></i></span>Reportes</a>
                <a asp-controller="Configuracion" asp-action="Index" data-m="config" class="@Activo("config")"><span class="ico"><i class="bi bi-sliders"></i></span>Configuración</a>
            }
        </nav>
        <div class="mt-4 px-2 small text-suave">@config.NombreNegocio</div>
    </aside>

    <main class="principal">
        <div class="topbar">
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-suave btn-icono btn-menu" type="button" aria-label="Abrir menú"><i class="bi bi-list"></i></button>
                <div>
                    @if (ViewData["Migas"] is string migas) { <div class="migas">@migas</div> }
                    <h1>@ViewData["Title"]</h1>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <div class="temas" title="Cambiar colores">
                    <button type="button" data-t="algodon" aria-label="Tema algodón (multicolor)"></button>
                    <button type="button" data-t="cielo" aria-label="Tema cielo"></button>
                    <button type="button" data-t="lavanda" aria-label="Tema lavanda"></button>
                    <button type="button" data-t="menta" aria-label="Tema menta"></button>
                    <button type="button" data-t="durazno" aria-label="Tema durazno"></button>
                </div>
                <div class="dropdown">
                    <button class="usuario-chip border-0" data-bs-toggle="dropdown" type="button">
                        <span class="avatar">@iniciales</span>
                        <span class="d-none d-md-block text-start pe-2" style="line-height:1.1">
                            <span class="d-block fw-semibold" style="font-size:13px">@u.Identity?.Name</span>
                            <span class="small text-suave">@Roles.Nombre(u.Rol())</span>
                        </span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end border-0 shadow-sm" style="border-radius:14px">
                        @if (admin)
                        {
                            <li><a class="dropdown-item" asp-controller="Usuarios" asp-action="Index"><i class="bi bi-person-gear me-2"></i>Usuarios</a></li>
                            <li><a class="dropdown-item" asp-controller="Configuracion" asp-action="Bitacora"><i class="bi bi-clock-history me-2"></i>Bitácora</a></li>
                            <li><hr class="dropdown-divider"></li>
                        }
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button class="dropdown-item" type="submit"><i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <partial name="_Avisos" />
        <div class="aparecer">
            @RenderBody()
        </div>
    </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
