@model Turno
@{ ViewData["Title"] = "Asignar turno"; ViewData["Migas"] = "Talento humano · turnos"; ViewData["Modulo"] = "talento"; }
<form asp-action="Crear" method="post" class="tarjeta" style="max-width:700px">
    <div asp-validation-summary="ModelOnly"></div>
    <div class="row g-3">
        <div class="col-md-6"><label asp-for="EmpleadoId" class="form-label"></label><select asp-for="EmpleadoId" class="form-select" asp-items="ViewBag.Empleados"><option value="0">Elige…</option></select><span asp-validation-for="EmpleadoId"></span></div>
        <div class="col-md-6"><label asp-for="Fecha" class="form-label"></label><input asp-for="Fecha" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="Tipo" class="form-label"></label><select asp-for="Tipo" class="form-select" asp-items="ViewBag.Tipos"></select></div>
        <div class="col-md-4"><label asp-for="HoraInicio" class="form-label"></label><input asp-for="HoraInicio" type="time" asp-format="{0:hh\:mm}" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="HoraFin" class="form-label"></label><input asp-for="HoraFin" type="time" asp-format="{0:hh\:mm}" class="form-control" /><span asp-validation-for="HoraFin"></span></div>
        <div class="col-12"><label asp-for="Observacion" class="form-label"></label><input asp-for="Observacion" class="form-control" /></div>
    </div>
    <div class="mt-4 d-flex gap-2"><button class="btn btn-mk"><i class="bi bi-check2"></i> Guardar</button><a asp-action="Index" class="btn btn-suave">Cancelar</a></div>
</form>
@section Scripts { <script>
const horarios = { 'Mañana': ['07:00', '15:00'], 'Tarde': ['13:00', '21:00'], 'Noche': ['21:00', '23:59'], 'Completo': ['08:00', '18:00'] };
document.getElementById('Tipo').addEventListener('change', e => { const h = horarios[e.target.value]; if (h) { document.getElementById('HoraInicio').value = h[0]; document.getElementById('HoraFin').value = h[1]; } });
</script> }
