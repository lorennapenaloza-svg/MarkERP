@model List<Categoria>
@{ ViewData["Title"] = "Categorías y bodegas"; ViewData["Migas"] = "Inventario"; ViewData["Modulo"] = "inventario"; var bodegas = (List<Bodega>)ViewBag.Bodegas; }
<div class="row g-3">
    <div class="col-lg-6">
        <div class="tarjeta">
            <h5><i class="bi bi-tags"></i> Categorías</h5>
            <form asp-action="CrearCategoria" method="post" class="row g-2 mb-3">
                <div class="col-5"><input name="nombre" class="form-control" placeholder="Nombre" required /></div>
                <div class="col-5"><input name="descripcion" class="form-control" placeholder="Descripción" /></div>
                <div class="col-2"><button class="btn btn-mk w-100"><i class="bi bi-plus-lg"></i></button></div>
            </form>
            <table class="tabla-mk"><thead><tr><th>Nombre</th><th class="num">Productos</th><th></th></tr></thead><tbody>
            @foreach (var c in Model)
            {
                <tr><td><b>@c.Nombre</b><div class="small text-suave">@c.Descripcion</div></td><td class="num">@c.Productos.Count</td>
                    <td class="text-end"><form asp-action="EliminarCategoria" asp-route-id="@c.Id" method="post" data-confirmar="¿Eliminar la categoría?"><button class="btn btn-suave btn-sm btn-icono" aria-label="Eliminar"><i class="bi bi-trash"></i></button></form></td></tr>
            }
            </tbody></table>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="tarjeta" style="--mod: var(--c-compras); --mod-f: var(--c-compras-f)">
            <h5><i class="bi bi-building"></i> Bodegas</h5>
            <form asp-action="CrearBodega" method="post" class="row g-2 mb-3">
                <div class="col-5"><input name="nombre" class="form-control" placeholder="Nombre" required /></div>
                <div class="col-5"><input name="ubicacion" class="form-control" placeholder="Ubicación" /></div>
                <div class="col-2"><button class="btn btn-mk w-100"><i class="bi bi-plus-lg"></i></button></div>
            </form>
            <table class="tabla-mk"><thead><tr><th>Nombre</th><th class="num">Productos</th><th class="num">Unidades</th><th></th></tr></thead><tbody>
            @foreach (var b in bodegas)
            {
                <tr><td><b>@b.Nombre</b><div class="small text-suave">@b.Ubicacion</div></td><td class="num">@b.Productos.Count</td><td class="num">@b.Productos.Sum(p => p.StockActual)</td>
                    <td class="text-end"><form asp-action="EliminarBodega" asp-route-id="@b.Id" method="post" data-confirmar="¿Eliminar la bodega?"><button class="btn btn-suave btn-sm btn-icono" aria-label="Eliminar"><i class="bi bi-trash"></i></button></form></td></tr>
            }
            </tbody></table>
        </div>
    </div>
</div>
