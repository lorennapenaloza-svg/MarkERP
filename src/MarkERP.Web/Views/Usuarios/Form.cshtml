@model UsuarioVM
@{ var nuevo = Model.Id == 0; ViewData["Title"] = nuevo ? "Nuevo usuario" : "Editar usuario"; ViewData["Migas"] = "Usuarios"; ViewData["Modulo"] = "config"; }
<form asp-action="@(nuevo ? "Crear" : "Editar")" asp-route-id="@Model.Id" method="post" class="tarjeta" style="max-width:640px">
    <div asp-validation-summary="ModelOnly"></div>
    <div class="row g-3">
        <div class="col-md-6"><label asp-for="Nombre" class="form-label"></label><input asp-for="Nombre" class="form-control" /><span asp-validation-for="Nombre"></span></div>
        <div class="col-md-6"><label asp-for="Email" class="form-label">Correo</label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email"></span></div>
        <div class="col-md-6"><label asp-for="Rol" class="form-label"></label>
            <select asp-for="Rol" class="form-select">@foreach (var r in Roles.Todos) { <option value="@r" selected="@(Model.Rol == r)">@Roles.Nombre(r)</option> }</select></div>
        <div class="col-md-6"><label asp-for="Password" class="form-label">@(nuevo ? "Contraseña" : "Nueva contraseña (opcional)")</label><input asp-for="Password" class="form-control" /><span asp-validation-for="Password"></span></div>
        <div class="col-12 form-check ms-2"><input asp-for="Activo" class="form-check-input" /><label asp-for="Activo" class="form-check-label">Usuario activo</label></div>
    </div>
    <div class="mt-4 d-flex gap-2"><button class="btn btn-mk"><i class="bi bi-check2"></i> Guardar</button><a asp-action="Index" class="btn btn-suave">Cancelar</a></div>
</form>
