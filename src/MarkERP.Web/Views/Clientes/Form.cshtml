@model Cliente
@{ var nuevo = Model.Id == 0; ViewData["Title"] = nuevo ? "Nuevo cliente" : "Editar cliente"; ViewData["Migas"] = "Clientes"; ViewData["Modulo"] = "clientes"; }
<form asp-action="@(nuevo ? "Crear" : "Editar")" asp-route-id="@Model.Id" method="post" class="tarjeta" style="max-width:820px">
    <div asp-validation-summary="ModelOnly"></div>
    <div class="row g-3">
        <div class="col-md-3"><label asp-for="TipoDocumento" class="form-label"></label><select asp-for="TipoDocumento" class="form-select" asp-items="ViewBag.TiposDoc"></select></div>
        <div class="col-md-4"><label asp-for="Documento" class="form-label"></label><input asp-for="Documento" class="form-control" /><span asp-validation-for="Documento"></span></div>
        <div class="col-md-5"><label asp-for="Nombre" class="form-label"></label><input asp-for="Nombre" class="form-control" /><span asp-validation-for="Nombre"></span></div>
        <div class="col-md-4"><label asp-for="Telefono" class="form-label"></label><input asp-for="Telefono" class="form-control" /></div>
        <div class="col-md-8"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email"></span></div>
        <div class="col-md-8"><label asp-for="Direccion" class="form-label"></label><input asp-for="Direccion" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="Ciudad" class="form-label"></label><input asp-for="Ciudad" class="form-control" /></div>
    </div>
    <div class="mt-4 d-flex gap-2"><button class="btn btn-mk"><i class="bi bi-check2"></i> Guardar</button><a asp-action="Index" class="btn btn-suave">Cancelar</a></div>
</form>
