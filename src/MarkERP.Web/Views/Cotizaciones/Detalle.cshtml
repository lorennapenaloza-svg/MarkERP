@model SolicitudCotizacion
@{ ViewData["Title"] = "Solicitud " + Model.Numero; ViewData["Migas"] = "Cotizaciones · " + Model.Descripcion; ViewData["Modulo"] = "cotizaciones";
   var recomendada = ViewBag.Recomendada as Cotizacion; var orden = ViewBag.Orden as OrdenCompra;
   var cots = Model.Cotizaciones.OrderByDescending(c => c.Puntaje).ToList();
   var abierta = Model.Estado == EstadosSolicitud.Enviada || Model.Estado == EstadosSolicitud.EnEvaluacion;
   var sinRespuesta = Model.Envios.Where(e => Model.Cotizaciones.All(c => c.ProveedorId != e.ProveedorId)).ToList();
   int paso = Model.Estado switch { "Enviada" => 2, "En evaluación" => 3, "Adjudicada" => orden == null ? 4 : 5, _ => 0 }; }

<div class="tarjeta mb-3">
    <div class="pasos">
        <div class="paso @(paso >= 2 ? "hecho" : "actual")"><i class="bi bi-send-check"></i> Enviada a @Model.Envios.Count proveedores</div>
        <div class="paso @(paso > 2 ? "hecho" : paso == 2 ? "actual" : "")"><i class="bi bi-inbox"></i> @Model.Cotizaciones.Count cotizaciones recibidas</div>
        <div class="paso @(paso > 3 ? "hecho" : paso == 3 ? "actual" : "")"><i class="bi bi-trophy"></i> Selección</div>
        <div class="paso @(paso > 4 ? "hecho" : paso == 4 ? "actual" : "")"><i class="bi bi-cart-check"></i> Orden de compra</div>
    </div>
    @if (Model.Estado == EstadosSolicitud.Cancelada) { <p class="mt-2 mb-0 pill peligro">Solicitud cancelada</p> }
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="tarjeta mb-3">
            <h5>Detalle de la solicitud</h5>
            <div class="dato"><span>Fecha</span><span>@Model.Fecha.ToString("dd/MM/yyyy")</span></div>
            <div class="dato"><span>Fecha límite</span><span>@Model.FechaLimite.ToString("dd/MM/yyyy")</span></div>
            <div class="dato"><span>Creada por</span><span>@Model.CreadaPor</span></div>
            <h6 class="mt-3 small fw-semibold">Productos</h6>
            @foreach (var i in Model.Items) { <div class="dato"><span>@i.Producto?.Nombre</span><span>@i.Cantidad und</span></div> }
            @if (abierta)
            {
                <form asp-action="Cancelar" asp-route-id="@Model.Id" method="post" data-confirmar="¿Cancelar la solicitud?" class="mt-3"><button class="btn btn-suave btn-sm w-100">Cancelar solicitud</button></form>
            }
        </div>
        <div class="tarjeta" style="--mod: var(--c-proveedores); --mod-f: var(--c-proveedores-f)">
            <h5>Envíos</h5>
            @foreach (var e in Model.Envios)
            {
                var resp = Model.Cotizaciones.Any(c => c.ProveedorId == e.ProveedorId);
                <div class="dato" style="align-items:center">
                    <span><span class="fw-semibold" style="color:var(--texto)">@e.Proveedor?.RazonSocial</span><br /><span class="small">@e.EmailDestino · @e.Estado</span></span>
                    <span class="d-flex gap-1 flex-column align-items-end">
                        @if (resp) { <span class="pill ok">Respondió</span> } else { <span class="pill alerta">Pendiente</span> }
                        <span class="d-flex gap-1">
                            <a asp-action="Imprimir" asp-route-id="@Model.Id" asp-route-proveedorId="@e.ProveedorId" target="_blank" class="btn btn-suave btn-sm btn-icono" title="Ver solicitud / PDF"><i class="bi bi-file-earmark-pdf"></i></a>
                            @if (abierta) { <a asp-action="Responder" asp-route-id="@Model.Id" asp-route-proveedorId="@e.ProveedorId" class="btn btn-mk btn-sm" title="Registrar cotización"><i class="bi bi-pencil-square"></i></a> }
                        </span>
                    </span>
                </div>
            }
            @if (abierta && sinRespuesta.Any())
            {
                <form asp-action="SimularRespuestas" asp-route-id="@Model.Id" method="post" class="mt-3">
                    <button class="btn btn-suave btn-sm w-100"><i class="bi bi-magic"></i> Simular respuestas de proveedores (demo)</button>
                </form>
            }
        </div>
    </div>

    <div class="col-lg-8">
        @if (!cots.Any())
        {
            <div class="tarjeta text-center py-5"><i class="bi bi-hourglass-split" style="font-size:36px;color:var(--mod-f)"></i>
                <h5 class="mt-2">Esperando cotizaciones</h5><p class="text-suave small mb-0">Registra lo que responda cada proveedor o usa el botón de simulación.</p></div>
        }
        else
        {
            @if (Model.Estado == EstadosSolicitud.Adjudicada)
            {
                var gan = cots.First(c => c.Id == Model.CotizacionGanadoraId);
                <div class="tarjeta mb-3" style="--mod: var(--ok)">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div><div class="small text-suave">Te quedaste con</div><h5 class="mb-1">@gan.Proveedor?.RazonSocial · @Calculos.Moneda(gan.Total)</h5>
                            <div class="small">@Model.MotivoSeleccion @if (Model.AhorroEstimado > 0) { <span class="pill ok ms-1">Ahorro @Calculos.Moneda(Model.AhorroEstimado)</span> }</div></div>
                        @if (orden == null)
                        {
                            <form asp-action="GenerarOrden" asp-route-id="@Model.Id" method="post"><button class="btn btn-mk"><i class="bi bi-cart-plus"></i> Generar orden de compra</button></form>
                        }
                        else
                        {
                            <a asp-controller="OrdenesCompra" asp-action="Detalle" asp-route-id="@orden.Id" class="btn btn-mk"><i class="bi bi-cart-check"></i> Ver orden @orden.Numero</a>
                        }
                    </div>
                </div>
            }

            <div class="tarjeta mb-3">
                <h5>Comparativo <span class="small text-suave fw-normal">· puntaje = 50 % precio + 30 % entrega + 20 % calificación</span></h5>
                <div class="row g-3">
                @foreach (var c in cots)
                {
                    var esRec = recomendada?.Id == c.Id;
                    var clase = c.Estado == EstadosCotizacion.Seleccionada ? "seleccionada" : c.Estado == EstadosCotizacion.Descartada ? "descartada" : esRec ? "recomendada" : "";
                    <div class="col-md-6 col-xl-4">
                        <div class="cot-card @clase h-100">
                            @if (c.Estado == EstadosCotizacion.Seleccionada) { <span class="pill mod mb-2"><i class="bi bi-check2-circle"></i> Seleccionada</span> }
                            else if (esRec && abierta) { <span class="pill ok mb-2"><i class="bi bi-stars"></i> Recomendada</span> }
                            <div class="fw-semibold">@c.Proveedor?.RazonSocial</div>
                            <div class="fs-4 fw-bold mt-1">@Calculos.Moneda(c.Total)</div>
                            <div class="small text-suave mb-2">IVA incluido · válida @c.ValidezDias días</div>
                            <div class="d-flex justify-content-between small"><span>Puntaje</span><b>@c.Puntaje.ToString("0.0") / 100</b></div>
                            <div class="barra mb-2"><div style="width:@c.Puntaje.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div></div>
                            <div class="dato"><span>Entrega</span><span>@c.TiempoEntregaDias @(c.TiempoEntregaDias == 1 ? "día" : "días")</span></div>
                            <div class="dato"><span>Pago</span><span>@c.CondicionesPago</span></div>
                            <div class="dato"><span>Calificación</span><span>★ @c.Proveedor?.Calificacion.ToString("0.0")</span></div>
                            @if (!string.IsNullOrEmpty(c.Observaciones)) { <p class="small text-suave mt-1 mb-2">@c.Observaciones</p> }
                            @if (abierta)
                            {
                                <form asp-action="Seleccionar" asp-route-id="@Model.Id" method="post" class="mt-2">
                                    <input type="hidden" name="cotizacionId" value="@c.Id" />
                                    <input name="motivo" class="form-control form-control-sm mb-2" placeholder="Motivo (opcional)" />
                                    <button class="btn @(esRec ? "btn-ok" : "btn-suave") btn-sm w-100"><i class="bi bi-hand-thumbs-up"></i> Quedarme con esta</button>
                                </form>
                            }
                        </div>
                    </div>
                }
                </div>
            </div>

            <div class="tarjeta tabla-wrap">
                <h5>Precio unitario por producto <span class="small text-suave fw-normal">· en verde el más bajo</span></h5>
                <table class="tabla-mk">
                    <thead><tr><th>Producto</th><th class="num">Cant.</th>@foreach (var c in cots) { <th class="num">@c.Proveedor?.RazonSocial</th> }</tr></thead>
                    <tbody>
                    @foreach (var i in Model.Items)
                    {
                        var precios = cots.Select(c => c.Detalles.FirstOrDefault(d => d.ProductoId == i.ProductoId)?.PrecioUnitario ?? 0).ToList();
                        var min = precios.Where(p => p > 0).DefaultIfEmpty(0).Min();
                        <tr><td>@i.Producto?.Nombre</td><td class="num">@i.Cantidad</td>
                            @foreach (var p in precios) { <td class="num @(p == min && p > 0 ? "mejor-precio" : "")">@Calculos.Moneda(p)</td> }</tr>
                    }
                    <tr><td colspan="2" class="fw-semibold">Total con IVA</td>@foreach (var c in cots) { <td class="num fw-bold">@Calculos.Moneda(c.Total)</td> }</tr>
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
