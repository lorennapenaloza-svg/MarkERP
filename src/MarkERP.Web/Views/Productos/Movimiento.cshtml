@model MovimientoVM
@{ var p = (Producto)ViewBag.Producto; ViewData["Title"] = Model.Tipo == "Ajuste" ? "Conteo físico" : Model.Tipo + " de inventario"; ViewData["Migas"] = p.Nombre; ViewData["Modulo"] = "inventario"; }
<form asp-action="Movimiento" method="post" class="tarjeta" style="max-width:620px">
    <div asp-validation-summary="ModelOnly"></div>
    <input type="hidden" asp-for="ProductoId" />
    <p class="text-suave">Stock actual: <b>@p.StockActual</b> (@p.Unidad.ToLower()).</p>
    <div class="row g-3">
        <div class="col-md-5"><label class="form-label">Tipo</label>
            <select asp-for="Tipo" class="form-select"><option value="Entrada">Entrada (suma)</option><option value="Salida">Salida (resta)</option><option value="Ajuste">Conteo físico (fija el stock)</option></select></div>
        <div class="col-md-7"><label class="form-label" id="lblCant">@(Model.Tipo == "Ajuste" ? "Cantidad contada físicamente" : "Cantidad")</label><input asp-for="Cantidad" type="number" min="0" class="form-control" /></div>
        <div class="col-md-7"><label class="form-label">Motivo</label><input asp-for="Motivo" class="form-control" list="motivos" placeholder="Compra local, daño, devolución…" /><span asp-validation-for="Motivo"></span>
            <datalist id="motivos"><option>Compra local</option><option>Devolución de cliente</option><option>Producto dañado</option><option>Conteo físico</option><option>Traslado entre bodegas</option><option>Muestra o regalo</option></datalist></div>
        <div class="col-md-5"><label class="form-label">Referencia (opcional)</label><input asp-for="Referencia" class="form-control" placeholder="Factura, remisión…" /></div>
    </div>
    <div class="mt-4 d-flex gap-2"><button class="btn btn-mk"><i class="bi bi-check2"></i> Registrar</button><a asp-action="Detalle" asp-route-id="@p.Id" class="btn btn-suave">Cancelar</a></div>
</form>
@section Scripts { <script>
document.getElementById('Tipo').addEventListener('change', e => document.getElementById('lblCant').textContent = e.target.value === 'Ajuste' ? 'Cantidad contada físicamente' : 'Cantidad');
</script> }
