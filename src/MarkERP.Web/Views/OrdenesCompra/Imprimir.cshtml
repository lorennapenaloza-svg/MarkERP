@model OrdenCompra
@{ Layout = "_LayoutSimple"; ViewData["Title"] = "Orden " + Model.Numero; ViewData["Modulo"] = "compras"; var c = (ConfiguracionNegocio)ViewBag.Config; }
<div class="hoja">
    <div class="encabezado">
        <div><h3 class="mb-1">@c.NombreNegocio</h3><div class="small">NIT @c.Nit<br />@c.Direccion<br />@c.Telefono · @c.Email</div></div>
        <div class="text-end"><div class="small text-suave">Orden de compra</div><h4 class="mb-1">@Model.Numero</h4><div class="small">@Model.Fecha.ToString("dd/MM/yyyy")<br />Estado: @Model.Estado</div></div>
    </div>
    <p class="small"><b>Proveedor:</b> @Model.Proveedor?.RazonSocial · NIT @Model.Proveedor?.Nit<br /><b>Contacto:</b> @Model.Proveedor?.Contacto · @Model.Proveedor?.Email · @Model.Proveedor?.Telefono<br />
        <b>Condiciones de pago:</b> @Model.CondicionesPago · <b>Entrega:</b> @Model.FechaEntregaEstimada?.ToString("dd/MM/yyyy")</p>
    <table class="tabla-mk mb-3"><thead><tr><th>Código</th><th>Producto</th><th class="num">Cantidad</th><th class="num">Precio</th><th class="num">Subtotal</th></tr></thead>
        <tbody>@foreach (var d in Model.Detalles) { <tr><td>@d.Producto?.Codigo</td><td>@d.Producto?.Nombre</td><td class="num">@d.Cantidad</td><td class="num">@Calculos.Moneda(d.PrecioUnitario)</td><td class="num">@Calculos.Moneda(d.Subtotal)</td></tr> }</tbody></table>
    <div class="ms-auto" style="max-width:300px">
        <div class="dato"><span>Subtotal</span><span>@Calculos.Moneda(Model.Subtotal)</span></div>
        <div class="dato"><span>IVA</span><span>@Calculos.Moneda(Model.Iva)</span></div>
        <div class="dato fs-5"><span>Total</span><span class="fw-bold">@Calculos.Moneda(Model.Total)</span></div>
    </div>
    <div class="row mt-5 small text-center"><div class="col">_______________________<br />Elaboró: @Model.CreadaPor</div><div class="col">_______________________<br />Aprobó</div></div>
    <div class="text-center no-print mt-4"><button onclick="window.print()" class="btn btn-mk"><i class="bi bi-printer"></i> Imprimir o guardar como PDF</button></div>
</div>
