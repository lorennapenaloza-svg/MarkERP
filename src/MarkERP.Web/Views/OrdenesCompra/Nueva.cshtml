@model NuevaOrdenVM
@{ ViewData["Title"] = "Orden de compra directa"; ViewData["Migas"] = "Compras"; ViewData["Modulo"] = "compras"; var productos = (List<Producto>)ViewBag.Productos; }
<form asp-action="Nueva" method="post">
<div asp-validation-summary="ModelOnly"></div>
<div class="tarjeta mb-3">
    <div class="row g-3">
        <div class="col-md-5"><label class="form-label">Proveedor</label><select asp-for="ProveedorId" class="form-select" asp-items="ViewBag.Proveedores"><option value="0">Elige…</option></select></div>
        <div class="col-md-3"><label class="form-label">Entrega estimada</label><input asp-for="FechaEntregaEstimada" type="date" class="form-control" /></div>
        <div class="col-md-4"><label class="form-label">Observaciones</label><input asp-for="Observaciones" class="form-control" /></div>
    </div>
</div>
<div class="tarjeta">
    <div class="d-flex justify-content-between mb-2"><h5 class="mb-0">Productos</h5><button type="button" id="agregar" class="btn btn-mk btn-sm"><i class="bi bi-plus-lg"></i> Producto</button></div>
    <table class="tabla-mk" id="lineas"><thead><tr><th>Producto</th><th style="width:120px">Cantidad</th><th style="width:170px">Precio unitario</th><th class="num">Subtotal</th><th></th></tr></thead><tbody></tbody></table>
    <template id="filaTpl"><tr>
        <td><select class="form-select form-select-sm" data-campo="ProductoId">@foreach (var p in productos) { <option value="@p.Id" data-precio="@p.PrecioCompra.ToString(System.Globalization.CultureInfo.InvariantCulture)">@p.Nombre</option> }</select></td>
        <td><input type="number" min="1" value="1" class="form-control form-control-sm" data-campo="Cantidad" /></td>
        <td><input type="number" min="1" step="1" class="form-control form-control-sm" data-campo="PrecioUnitario" /></td>
        <td class="num sub"></td>
        <td><button type="button" class="btn btn-suave btn-sm btn-icono quitar" aria-label="Quitar"><i class="bi bi-x"></i></button></td>
    </tr></template>
    <div class="text-end fw-semibold mt-2">Subtotal: <span id="total">$0</span> <span class="small text-suave">(+ IVA)</span></div>
    <button class="btn btn-mk mt-3"><i class="bi bi-check2"></i> Crear orden</button>
</div>
</form>
@section Scripts { <script>
const lineas = LineasDinamicas({ tabla: '#lineas', plantilla: '#filaTpl', prefijo: 'Items', alCambiar: calc });
function calc(tbody) { let t = 0; tbody.querySelectorAll('tr').forEach(tr => {
    const pr = tr.querySelector('[data-campo=PrecioUnitario]'), sel = tr.querySelector('select');
    if (!pr.value || pr.dataset.prod !== sel.value) { pr.value = Math.round(parseFloat(sel.selectedOptions[0].dataset.precio)); pr.dataset.prod = sel.value; }
    const s = (parseFloat(pr.value) || 0) * (parseInt(tr.querySelector('[data-campo=Cantidad]').value) || 0); tr.querySelector('.sub').textContent = moneda(s); t += s; });
    document.getElementById('total').textContent = moneda(t); }
document.getElementById('agregar').addEventListener('click', () => lineas.agregar()); lineas.agregar();
</script> }
