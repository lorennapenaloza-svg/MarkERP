@model Novedad
@{ ViewData["Title"] = "Registrar novedad"; ViewData["Migas"] = "Talento humano"; ViewData["Modulo"] = "talento"; }
<form asp-action="Crear" method="post" class="tarjeta" style="max-width:700px">
    <div asp-validation-summary="ModelOnly"></div>
    <div class="row g-3">
        <div class="col-md-6"><label asp-for="EmpleadoId" class="form-label"></label><select asp-for="EmpleadoId" class="form-select" asp-items="ViewBag.Empleados"><option value="0">Elige…</option></select><span asp-validation-for="EmpleadoId"></span></div>
        <div class="col-md-3"><label asp-for="Tipo" class="form-label"></label><select asp-for="Tipo" class="form-select" asp-items="ViewBag.Tipos"></select></div>
        <div class="col-md-3"><label asp-for="Estado" class="form-label"></label><select asp-for="Estado" class="form-select" asp-items="ViewBag.Estados"></select></div>
        <div class="col-md-6"><label asp-for="FechaInicio" class="form-label"></label><input asp-for="FechaInicio" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="FechaFin" class="form-label"></label><input asp-for="FechaFin" class="form-control" /><span asp-validation-for="FechaFin"></span></div>
        <div class="col-12"><label asp-for="Descripcion" class="form-label"></label><textarea asp-for="Descripcion" rows="2" class="form-control"></textarea></div>
    </div>
    <div class="mt-4 d-flex gap-2"><button class="btn btn-mk"><i class="bi bi-check2"></i> Guardar</button><a asp-action="Index" class="btn btn-suave">Cancelar</a></div>
</form>
